# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" (it is already in .gitignore) and never paste keys into chat.
# Use ONE of the options below. Delete or comment out the others.

# --- Option 1: OpenAI API (billed separately from ChatGPT Plus) ---
LLM_MODEL=openai/REPLACE_WITH_MODEL_NAME
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY

# --- Option 2: Google Gemini (free tier available; check current limits) ---
# LLM_MODEL=gemini/REPLACE_WITH_MODEL_NAME
# GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY

# --- Option 3: Groq (free tier available; check current limits) ---
# LLM_MODEL=groq/REPLACE_WITH_MODEL_NAME
# GROQ_API_KEY=REPLACE_WITH_YOUR_KEY

# --- Option 4: local model with Ollama (no key, runs on your laptop) ---
# LLM_MODEL=ollama/REPLACE_WITH_MODEL_NAME
