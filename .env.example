# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" (it is already in .gitignore) and never paste keys into chat.

# Model string uses the LiteLLM format: openai/<model-name>
# Pick a small, inexpensive model from OpenAI's models page.
LLM_MODEL=openai/REPLACE_WITH_MODEL_NAME
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
